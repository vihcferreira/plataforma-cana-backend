# Ambiente de execução (development | production)
ENVIRONMENT=development

# Origens extras permitidas no CORS em produção (separadas por vírgula)
CORS_ORIGINS=https://seu-projeto.vercel.app

# Banco de Dados MySQL (aceita mysql+pymysql:// ou mysql:// de Aiven / TiDB Cloud)
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/water_management?charset=utf8mb4
DB_SSL_REQUIRED=false

# Projeto Firebase Auth (validação RS256 de ID Tokens)
FIREBASE_PROJECT_ID=plataforma-efluentes-250eb
REQUIRE_EMAIL_VERIFIED=false

# Integridade SHA-256 do Modelo Supervisionado (.pkl)
WATER_QUALITY_MODEL_SHA256=b679da26860f04e701b219b1c858f77640ffcf8b02eb15f8019aca7a8aacbb9c

# Credenciais do Groq AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
